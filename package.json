{
  "name": "nivguard",
  "version": "1.0.0",
  "description": "Onchain spend firewall for AI agents, built on Arc",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js",
    "deploy:arc": "hardhat run scripts/deploy.js --network arcTestnet",
    "node": "hardhat node",
    "setup:local": "node agent/setupLocal.js",
    "demo": "node agent/demo.js",
    "demo:arc": "node agent/demo.js --network arcTestnet",
    "demo:replay": "node scripts/replayDemo.js",
    "provision": "node agent/provision.js",
    "setup:arc": "node scripts/setupArc.js",
    "fund:agent": "node scripts/fundAgent.js",
    "pay:arc": "node scripts/agentPay.js",
    "preflight": "node scripts/preflight.js",
    "preflight:arc": "node scripts/preflight.js --network arcTestnet",
    "nano:key": "node scripts/newNanoAgent.js",
    "nano:setup": "node scripts/setupNano.js",
    "nano:seller": "node scripts/nanoSeller.js",
    "nano:demo": "node agent/nanoDemo.js",
    "sync:dashboard": "node scripts/syncDashboard.js",
    "web": "node scripts/serveWeb.js"
  },
  "keywords": [
    "arc",
    "usdc",
    "ai-agents",
    "solidity"
  ],
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.0"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/x402-batching": "^3.3.0",
    "@x402/evm": "^2.21.0",
    "viem": "^2.55.11"
  }
}
