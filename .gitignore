# Environment and secrets
.env
.env.*
!.env.example

# Circle entity secret recovery file. Losing it locks you out, committing it
# hands over control of every wallet in the entity.
*-recovery-file.json
*.pem

# Dependencies
node_modules/

# Hardhat build output
artifacts/
cache/
typechain/
typechain-types/

# Coverage and gas reports
coverage/
coverage.json
gas-report.txt

# Deployment records
deployments/*.json
!deployments/.gitkeep

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
