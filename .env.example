# Copy to .env and fill in. Never commit .env.

# Deployer private key, no 0x prefix required but accepted.
PRIVATE_KEY=

# Arc testnet RPC. Override only if you use a provider endpoint.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# USDC ERC-20 interface on Arc testnet, 6 decimals.
# Leave as is unless you are deploying against a mock.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional. Defaults to the deployer address.
FIREWALL_OWNER=

# Circle developer-controlled wallets, for agent custody on Arc.
# The agent signs through Circle, so no agent key is ever stored here.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Written back by `npm run provision`. Leave blank on a first run.
CIRCLE_WALLET_SET_ID=
AGENT_WALLET_ID=
AGENT_WALLET_ADDRESS=

# ---------------------------------------------------------------------
# Nanopayments (docs/NANOPAYMENTS.md)
# ---------------------------------------------------------------------

# The agent's nanopayment signing key. This is the one place a raw agent key
# is needed, and it is not a shortcut: Circle's x402 batching SDK signs
# offchain EIP-3009 authorizations with a raw private key and offers no custom
# signer hook, so a developer-controlled wallet cannot sign nanopayments.
#
# Treat it as a hot key. It only ever controls what the firewall has already
# released into the Gateway pool under policy, which is the blast radius the
# firewall exists to bound. Generate one with `npm run nano:key -- --write`.
AGENT_GATEWAY_PRIVATE_KEY=

# Optional overrides for the x402 seller.
# NANO_SELLER_PORT=4021
# NANO_SELLER_ADDRESS=
# NANO_FACILITATOR_URL=https://gateway-api-testnet.circle.com
