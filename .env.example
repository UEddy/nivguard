# Copy to .env and fill in. Never commit .env.

# Deployer private key, no 0x prefix required but accepted.
PRIVATE_KEY=

# Arc testnet RPC. Override only if you use a provider endpoint.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# USDC ERC-20 interface on Arc testnet, 6 decimals.
# Leave as is unless you are deploying against a mock.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional. Defaults to the deployer address.
FIREWALL_OWNER=

# Circle developer-controlled wallets, for agent custody on Arc.
# The agent signs through Circle, so no agent key is ever stored here.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Written back by `npm run provision`. Leave blank on a first run.
CIRCLE_WALLET_SET_ID=
AGENT_WALLET_ID=
AGENT_WALLET_ADDRESS=
